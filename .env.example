# ==============================================================================
# Tệp Cấu Hình Biến Môi Trường Mẫu: ReplyMind
# ==============================================================================
# Sao chép tệp này thành .env.local để sử dụng trong môi trường phát triển cục bộ.
# TUYỆT ĐỐI KHÔNG lưu thông tin xác thực thật hoặc secret của môi trường production vào Git.

# Môi trường Ứng dụng
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cấu hình Cơ sở Dữ liệu (PostgreSQL hỗ trợ pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/replymind?schema=public"

# Xác thực & Bảo mật (NextAuth / JWT)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="thay-the-bang-mot-chuoi-hex-ngau-nhien-32-byte"
JWT_SECRET="thay-the-bang-mot-chuoi-jwt-secret-ngau-nhien"

# Khóa API của các Nhà cung cấp Mô hình LLM Chính
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIzaSy..."

# Cấu hình Mặc định cho Bộ Điều Phối AI
DEFAULT_LLM_PROVIDER="openai" # "openai" | "anthropic" | "gemini"
DEFAULT_COMPLETION_MODEL="gpt-4o"
DEFAULT_EMBEDDING_MODEL="text-embedding-3-small"

# Cơ sở Dữ liệu Vector / Tìm kiếm Tri thức RAG (Tùy chọn)
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME="replymind-kb"

# Hệ thống Theo dõi Lỗi & Ghi Nhật ký (Tùy chọn)
SENTRY_DSN=""
LOG_LEVEL="debug" # "debug" | "info" | "warn" | "error"
